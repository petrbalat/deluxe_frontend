{
  "name": "@softdeluxe/deluxe-frontend",
  "version": "0.10.7",
  "exports": "./mod.ts",
  "tasks": {
    "check": "deno check --unstable-tsgo  mod.ts",
    "check-full": "deno fmt --check && deno lint && deno check --unstable-tsgo **/*.ts && deno check--unstable-tsgo  **/*.tsx",
    "test": "deno test -A --no-check tests/**/*.ts",
    "publish": "deno task check && deno task test && deno publish"
  },
  "imports": {
    "rxjs": "npm:rxjs@8.0.0-alpha.14",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/async": "jsr:@std/async@^1.0.15",
    "@workingdevshero/deno-imap": "jsr:@workingdevshero/deno-imap@^1.0.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["esnext", "DOM", "deno.ns"],
    "types": []
  }
}
